{
  "expo": {
    "name": "Barrier Island",
    "slug": "barrier-island",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "platforms": [
      "ios",
      "web"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "org.louisianastatemuseum.barrierisland",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "Barrier Island connects to the exhibit display on the museum's local network."
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    }
  }
}
